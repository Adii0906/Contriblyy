# Contribly server configuration. Copy to .env.local for local development and
# add the same variables in Vercel (Project > Settings > Environment Variables).
# None of these use the NEXT_PUBLIC_ prefix: they are read on the server only
# and never shipped to the browser.

# ---- GitHub (search and verification) ----
# Fine-grained token with "Public repositories (read-only)" access, nothing else.
GITHUB_TOKEN=github_pat_replace_me

# ---- Supabase (accounts, saved issues, preferences) ----
# Project Settings > API (Data API). Leave both unset to run without accounts.
SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or, on older projects, the anon key.
# It is safe with Row Level Security, but the app still keeps it server-side.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Optional: server-only Supabase secret key for Auth IP forwarding.
# Only use a new sb_secret_... key; never expose it with a NEXT_PUBLIC_ prefix.
# It is not used for database requests. Enable IP Address Forwarding in Auth settings.
# SUPABASE_SECRET_KEY=sb_secret_replace_me

# Public base URL used in verification and password-reset emails.
# Local: http://localhost:3000   Production: https://your-domain.example
# On Vercel previews it falls back to the branch URL when unset.
SITE_URL=http://localhost:3000

# ---- Test mode only. Leave unset for normal use. ----
# CONTRIBLY_TEST_MODE=1
# GITHUB_API_URL=http://localhost:4010
